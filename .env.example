# PostgreSQL - alwaysdata managed
DATABASE_URL=postgresql://account:password@postgresql-account.alwaysdata.net:5432/account_wabo

# RabbitMQ - alwaysdata managed
RABBITMQ_URL=amqp://account:password@rabbitmq-account.alwaysdata.net:5672

# OpenRouter AI (https://openrouter.ai/keys) - GRATIS!
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AI_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
BOT_SYSTEM_PROMPT=Kamu adalah asisten yang ramah dan membantu. Jawab dalam bahasa yang sama dengan pengguna.

LOG_LEVEL=silent

# API Key untuk proteksi /docs dan /api
API_KEY=ganti-dengan-key-rahasia-kamu
